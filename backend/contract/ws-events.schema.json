    "ClientMessage": {
      "discriminator": {
        "mapping": {
          "playback.position": "#/$defs/PlaybackPosition",
          "session.start": "#/$defs/SessionStart",
          "session.stop": "#/$defs/SessionStop",
          "text.message": "#/$defs/TextMessage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SessionStart"
        },
        {
          "$ref": "#/$defs/SessionStop"
        },
        {
          "$ref": "#/$defs/TextMessage"
        },
