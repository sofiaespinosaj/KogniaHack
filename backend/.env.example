# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- SODA3 (datos.gov.co) ---
# Opcional si existe data/snapshot.parquet (solo se omite el refresco).
SODA_APP_TOKEN=
SODA_PAGE_SIZE=1000
SODA_CONCURRENCY=4
SODA_MAX_TRIES=5

# --- Datos y servidor ---
# Opcional: por defecto se usa data/ en la raíz del repo.
# DATA_PATH=../data
CORS_ORIGINS=http://localhost:5173

# --- Módulos de voz ---
VOICE_ENABLED=false
# groq   = Deepgram escucha (con hablantes) + Groq responde con las tools + Deepgram Aura-2 habla.
#          Claves: GROQ_API_KEY y DEEPGRAM_API_KEY.
# openai = OpenAI Realtime voz a voz + Deepgram para la diarización. Claves: OPENAI_API_KEY y DEEPGRAM_API_KEY.
VOICE_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Respaldos en orden (separados por coma) cuando el principal agota su cuota por minuto; none = sin respaldo.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b,llama-3.3-70b-versatile
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Voz en español de Aura-2 (celeste = acento colombiano). Velocidad 0.9 a 1.5 (por defecto 1.15; none = normal).
DEEPGRAM_TTS_MODEL=aura-2-celeste-es
DEEPGRAM_TTS_SPEED=1.15
# Sentimiento y emoción por frase (Groq llama-3.1-8b-instant si hay GROQ_API_KEY; si no, OpenAI).
SENTIMENT_ENABLED=true
GROQ_SENTIMENT_MODEL=llama-3.1-8b-instant
# Silencio (ms) que cierra el turno del usuario en modo groq.
ENDPOINTING_MS=400
UTTERANCE_END_MS=1000

# Solo con VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin
# Velocidad de la voz (0.25 a 1.5); menos de 1 = más pausada.
REALTIME_SPEED=0.9
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-live-transcribe

# --- Detección de turno (VAD de OpenAI, solo VOICE_PROVIDER=openai) ---
VAD_TYPE=server_vad
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_MS=500
# Ventana anti-eco tras el primer audio del agente (TBD, calibrar); 0 = sin ventana.
ECHO_WINDOW_MS=0

# --- Protección del WebSocket ---
WS_MAX_SESSIONS=3
WS_SESSIONS_PER_MINUTE=10
SESSION_MAX_SECONDS=900
SESSION_WARN_SECONDS=780
