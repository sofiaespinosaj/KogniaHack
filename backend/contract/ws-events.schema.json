        "code",
        "message",
        "recoverable",
        "seq",
        "severity",
        "type",
        "v"
      ],
      "title": "ErrorMsg",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "first_audio_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
