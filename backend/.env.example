# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- SODA3 (datos.gov.co) ---
# Opcional si existe data/snapshot.parquet (solo se omite el refresco).
SODA_APP_TOKEN=
SODA_PAGE_SIZE=1000
SODA_CONCURRENCY=4
SODA_MAX_TRIES=5

# --- Datos y servidor ---
# Ruta al snapshot relativa a backend/ (el snapshot está en data/ en la raíz del repo).
DATA_PATH=../data
CORS_ORIGINS=http://localhost:5173

# --- Módulos de voz ---
# Si VOICE_ENABLED=true, OPENAI_API_KEY y DEEPGRAM_API_KEY son obligatorias.
VOICE_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-live-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Detección de turno (VAD de OpenAI) ---
VAD_TYPE=server_vad
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_MS=500
# Ventana anti-eco tras el primer audio del agente (TBD, calibrar); 0 = sin ventana.
ECHO_WINDOW_MS=0

# --- Protección del WebSocket ---
WS_MAX_SESSIONS=3
WS_SESSIONS_PER_MINUTE=10
SESSION_MAX_SECONDS=900
SESSION_WARN_SECONDS=780
