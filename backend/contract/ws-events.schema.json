    "ErrorMsg": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "voice_disabled",
            "session_already_active",
            "session_limit",
            "unsupported_protocol",
            "invalid_message",
            "no_active_session",
            "origin_not_allowed",
            "session_expiring",
            "openai_unavailable",
            "deepgram_unavailable",
            "data_unavailable",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "p. ej. {'reason': 'rate'} o {'seconds_left': 120}.",
          "title": "Detail"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "title": "Recoverable",
          "type": "boolean"
        },
        "seq": {
          "description": "Entero estrictamente creciente por conexión.",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "severity": {
          "enum": [
            "warning",
            "fatal"
          ],
          "title": "Severity",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        }
