# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- SODA3 (datos.gov.co) ---
# Opcional si existe data/snapshot.parquet (solo se omite el refresco).
SODA_APP_TOKEN=
SODA_PAGE_SIZE=1000
SODA_CONCURRENCY=4
SODA_MAX_TRIES=5

# --- Datos y servidor ---
DATA_PATH=data
CORS_ORIGINS=http://localhost:5173

# --- Módulos de voz ---
# Si VOICE_ENABLED=true, OPENAI_API_KEY y DEEPGRAM_API_KEY son obligatorias.
VOICE_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-mini
DEEPGRAM_API_KEY=
